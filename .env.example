# Example environment variables for local development

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=verityops
DB_USERNAME=verityops
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=

# Required only when bootstrapping a brand-new, empty database.
# Use unique values and inject the password from a secret manager in production.
INITIAL_ADMIN_USERNAME=initial-admin
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_PASSWORD=

# Mail
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_FROM=verityops@example.invalid
APP_PUBLIC_URL=http://127.0.0.1:5176

# AI Service
AI_ENABLED=false

# Same-origin reverse proxy serves the UI and forwards /api to the backend.
FRONTEND_PORT=5176
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5176,http://localhost:5176
REFRESH_COOKIE_SECURE=false
SECURITY_REGISTRATION_ENABLED=false

# Files
FILES_UPLOAD_DIR=./var/evidence
