# Backend Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/audit_db
SPRING_DATASOURCE_USERNAME=audit_user
SPRING_DATASOURCE_PASSWORD=audit_password_secure_123
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_min_256_chars_long_for_security_purposes
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Redis Configuration
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
SPRING_CACHE_TTL=600

# AI Service
AI_SERVICE_URL=http://ai-service:5000
GROQ_API_KEY=your_groq_api_key_here

# Email Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password
SPRING_MAIL_FROM=noreply@auditfinder.com

# Application Configuration
SPRING_APPLICATION_NAME=audit-finding-tracker
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_INTERNSHIP_TOOL=DEBUG