# Example environment variables for local development

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aft
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-secret-to-a-very-long-random-string-please-change

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your@example.com
MAIL_PASSWORD=supersecret

# AI Service
AI_SERVICE_URL=http://ai-service:5000

# Files
FILES_UPLOAD_DIR=./uploads
